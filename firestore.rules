rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // --- Twitter Profiles ---
    match /twitterProfiles/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isOwner(userId) && 
        incoming().displayName is string && incoming().displayName.size() <= 50;
    }

    // --- Twitter Posts ---
    match /twitterPosts/{postId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && 
        incoming().content is string && incoming().content.size() <= 1000;
      allow update: if isSignedIn() && (
        isOwner(existing().authorId) || 
        incoming().diff(existing()).affectedKeys().hasAny(['likesCount', 'commentsCount'])
      );
      allow delete: if isSignedIn() && isOwner(existing().authorId);
    }

    // --- Twitter Comments ---
    match /twitterPosts/{postId}/comments/{commentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && 
        incoming().content is string && incoming().content.size() <= 500;
      allow delete: if isSignedIn() && isOwner(existing().authorId);
    }

    // --- Twitter Likes ---
    match /twitterPosts/{postId}/likes/{userId} {
      allow get, list: if isSignedIn();
      allow create, delete: if isOwner(userId);
    }

    // --- Twitter Chats & Messages ---
    match /twitterChats/{chatId}/messages/{messageId} {
      // chatId usually contains both user IDs, e.g. "uid1_uid2"
      allow get, list: if isSignedIn() && chatId.contains(request.auth.uid);
      allow create: if isSignedIn() && 
        incoming().senderId == request.auth.uid &&
        chatId.contains(request.auth.uid);
    }
  }
}
